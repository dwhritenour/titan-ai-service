# Titan AI agent service — copy to .env and fill in. Never commit .env.

# Nexus SQL Server
NEXUS_SERVER=
NEXUS_DATABASE=

# Service login (chat tables only) — from sql/titan_ai_logins.sql
TITAN_AI_SVC_USERNAME=
TITAN_AI_SVC_PASSWORD=

# Read-only login handed to nexus-mcp-server — from sql/titan_ai_logins.sql
NEXUS_RO_USERNAME=
NEXUS_RO_PASSWORD=

# Anthropic
ANTHROPIC_API_KEY=
TITAN_AI_MODEL=claude-sonnet-5
TITAN_AI_AGENT_MODEL=
TITAN_AI_MAX_TOKENS=8000

# ElevenLabs (Voice)
ELEVENLABS_API_KEY=
# optional:
# ELEVENLABS_VOICE_ID=
# VOICE_SUMMARY_MODEL=
# ELEVENLABS_STT_MODEL=

# nexus-mcp-server compiled entry point on this machine (Hermes)
NEXUS_MCP_PATH=C:\nexus-mcp-server\dist\index.js
NODE_COMMAND=node

# Spec Sheets & How-To Docs
SPEC_SHEETS_DIR=C:\spec_sheets
HOWTO_DOCS_DIR=C:\titan_ai_howto

# Website crawl (v1.3) — public side works with defaults
WEBSITE_URL=https://titanfci.co
WEBSITE_MAX_PAGES=300
WEBSITE_REFRESH_DAYS=7

# Secure/dealer side (optional — leave blank to skip). Use a DEDICATED
# account created for Titan AI, not a personal login.
WEBSITE_LOGIN_URL=
WEBSITE_USERNAME=
WEBSITE_PASSWORD=

# Comma-separated secure start pages: consignment sites + solid-model
# listings. Do NOT include plain inventory pages (Nexus is fresher).
WEBSITE_SECURE_START_URLS=

# Daily Plan agent (v1.6) — the 06:30 proposal run for the Titan Daily
# Plan app. Both required or the module stays off. AGENT_API_KEY must
# EQUAL the Anvil Secret AGENT_API_KEY in the Titan Daily Plan app.
DAILY_PLAN_APP_URL=https://titan-plan.anvil.app
AGENT_API_KEY=
DAILY_PLAN_NARRATIVE_MAX_TOKENS=1500

# Optional: 0 pauses the run without touching Nexus (pc_plan_parameters
# AGENT_ENABLED is the normal switch, editable in the app).
DAILY_PLAN_AGENT_ENABLED=1

# Twilio — copy the three values from the Hub Transfers app's Anvil
# Secrets. Blank = texts are logged to ai_agent_log but not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# true = log texts, never send (first-morning safety)
SMS_TEST_MODE=false

# Behavior (defaults are fine)
TITAN_AI_POLL_SECONDS=1.0
TITAN_AI_MAX_TOOL_ITERATIONS=8
TITAN_AI_HISTORY_MAX_TURNS=20

